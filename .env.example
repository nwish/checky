# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is the committed template.
# All values are optional — without SMTP_HOST, invitation emails
# are printed to the server console instead of being sent.

SMTP_HOST=smtp.fastmail.com
SMTP_PORT=587
# Set to 1 for implicit TLS (port 465); leave commented for STARTTLS (587)
#SMTP_SECURE=1
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Checky <checky@example.com>
# Base URL used in invitation links (defaults to the request origin)
#APP_URL=http://localhost:3001
